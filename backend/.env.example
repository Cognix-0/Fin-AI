DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/finance_db
# Log every SQL statement (very noisy)
DB_ECHO=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be >= 32 chars when ENVIRONMENT=production or the app refuses to start.
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# Lock out an IP+email pair after this many failed logins
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Receipt uploads
UPLOAD_DIR=uploads
MAX_RECEIPT_MB=10

FRONTEND_URL=http://localhost:3000
# Additional CORS origins, comma separated
CORS_EXTRA_ORIGINS=
ENVIRONMENT=development
